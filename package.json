{
  "name": "dangila-digital-woreda-services",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Assisted Digital Woreda Services for Dangila",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "turbo run build",
    "start": "cd backend && npm start",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "seed": "cd backend && npm run seed"
  },
  "devDependencies": {
    "turbo": "^1.13.3",
    "prettier": "^3.2.5",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Yetemare Yibeltal",
  "license": "MIT"
}

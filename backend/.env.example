# =============================================
# SERVER CONFIGURATION
# =============================================
NODE_ENV=development
PORT=5000
HOST=localhost

# =============================================
# MONGODB DATABASE
# =============================================
# Get your free connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/dangila_woreda?retryWrites=true&w=majority

# =============================================
# JWT AUTHENTICATION
# =============================================
# Use a strong random string. Generate one with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =============================================
# FRONTEND URL (for CORS)
# =============================================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# =============================================
# GOOGLE GEMINI AI (Free Tier)
# =============================================
# Get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================
# ADMIN SEED CREDENTIALS
# =============================================
ADMIN_EMAIL=admin@dangila.gov.et
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=Woreda Administrator

# =============================================
# RATE LIMITING
# =============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=20

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# =============================================
# UPLOAD CONFIGURATION
# =============================================
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# =============================================
# EMAIL CONFIGURATION (Optional - for notifications)
# =============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@dangila.gov.et
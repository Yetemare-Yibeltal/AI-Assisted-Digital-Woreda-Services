{
  "watch": ["src"],
  "ext": "ts,js,json",
  "ignore": ["src/**/*.test.ts", "src/**/*.spec.ts", "node_modules", "dist"],
  "exec": "ts-node src/server.ts",
  "delay": 1000,
  "verbose": true,
  "env": {
    "NODE_ENV": "development"
  },
  "events": {
    "restart": "echo 'Server restarted due to file changes'",
    "crash": "echo 'Server crashed! Check logs for details'"
  },
  "legacyWatch": false,
  "pollingInterval": 1000
}
